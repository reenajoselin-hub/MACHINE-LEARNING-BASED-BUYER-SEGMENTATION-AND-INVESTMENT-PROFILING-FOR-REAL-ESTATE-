      <aliases enabled='yes' />
      <column caption='Age' datatype='integer' name='[Calculation_1561339098439680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [date_of_birth], TODAY())' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1561339099877377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1561339098439680] &lt; 30 THEN &quot;Under 30&quot;&#13;&#10;ELSEIF [Calculation_1561339098439680] &lt; 40 THEN &quot;30–39&quot;&#13;&#10;ELSEIF [Calculation_1561339098439680] &lt; 50 THEN &quot;40–49&quot;&#13;&#10;ELSEIF [Calculation_1561339098439680] &lt; 60 THEN &quot;50–59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Buyer Purpose' datatype='string' name='[Calculation_1561339101589506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [acquisition_purpose] = &quot;Investment&quot; THEN &quot;Investment Buyer&quot;&#13;&#10;ELSE &quot;Personal Use Buyer&quot;&#13;&#10;END' />
      </column>
      <column caption='Loan Status' datatype='string' name='[Calculation_1561339101847555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [loan_applied] = &quot;Yes&quot; THEN &quot;Loan Applied&quot;&#13;&#10;ELSE &quot;No Loan&quot;&#13;&#10;END' />
      </column>
      <column caption='Satisfaction Category' datatype='string' name='[Calculation_1561339102412804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [satisfaction_score] &gt;= 4 THEN &quot;Highly Satisfied&quot;&#13;&#10;ELSEIF [satisfaction_score] &gt;= 3 THEN &quot;Satisfied&quot;&#13;&#10;ELSE &quot;Low Satisfaction&quot;&#13;&#10;END' />
      </column>
